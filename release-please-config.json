{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "package-name": "edic-design-system",
  "include-v-in-tags": true,
  "include-component-in-tag": false,
  "changelog-sections": [
    { "type": "feat",     "section": "新增",      "hidden": false },
    { "type": "fix",      "section": "修复",      "hidden": false },
    { "type": "perf",     "section": "性能优化",  "hidden": false },
    { "type": "refactor", "section": "重构",      "hidden": false },
    { "type": "docs",     "section": "文档",      "hidden": false },
    { "type": "style",    "section": "样式",      "hidden": false },
    { "type": "test",     "section": "测试",      "hidden": true  },
    { "type": "build",    "section": "构建",      "hidden": true  },
    { "type": "ci",       "section": "CI",        "hidden": true  },
    { "type": "chore",    "section": "其他",      "hidden": true  },
    { "type": "revert",   "section": "回滚",      "hidden": false }
  ],
  "extra-files": [
    "VERSION",
    { "type": "json", "path": "tokens.json",  "jsonpath": "$.version" },
    { "type": "json", "path": "package.json", "jsonpath": "$.version" }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "VERSION",
        { "type": "json", "path": "tokens.json",  "jsonpath": "$.version" },
        { "type": "json", "path": "package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
